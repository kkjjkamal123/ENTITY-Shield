<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets scripts/e2e_phone.py drive the pipeline over adb. Not in release APKs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.entity.shield.DEBUG" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
