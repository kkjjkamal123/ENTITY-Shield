# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Model weights and exported runtimes (large; publish via Releases / Hugging Face)
models/*
!models/.gitkeep
*.pte
*.gguf
*.safetensors
*.pt
*.pth
*.onnx
*.bin

# Datasets and captures (licensed / large / private)
datasets/*
!datasets/.gitkeep
*.pcap
*.pcapng

# Android
android-app/**/build/
android-app/.gradle/
android-app/local.properties
*.apk
*.aab
*.keystore
*.jks

# Secrets
.env
*.key

# Third-party sources (ExecuTorch checkout for Android builds)
third_party/

# Demo video intermediates (the final demo/ENTITY-Shield-demo.mp4 is committed)
demo/raw/
demo/build/
release/

# Local tool state (worktrees, editor settings)
.claude/

# Small on-device detector models and Network Guard lists ARE committed, so the app builds from a clean
# clone (the Llama .pte stays out: 1.1 GB, published with the release).
!models/detectors/
models/detectors/*
!models/detectors/sms.pte
!models/detectors/url.pte
!models/detectors/popular.bin
!models/detectors/phish.bin
!models/detectors/dns_lists.json
!models/detectors/v1/
models/detectors/v1/*
!models/detectors/v1/url.pte
!models/detectors/v1/url_meta.json
!models/detectors/v1/allowlist.txt
